; RUN: rm -rf %t && mkdir %t

; Generate indexed profiles from text profiles
RUN: llvm-profdata merge %S/Inputs/argument-value-prof.proftext -o %t/indexed.profdata

; Show indexed profiles
RUN: llvm-profdata show --function=main --argument-values %t/indexed.profdata | FileCheck %s --check-prefix=INDEXED

; Show text profiles
RUN: llvm-profdata show --function=main --argument-values --text %S/Inputs/argument-value-prof.proftext | FileCheck %s --check-prefix=ARGTEXT

; Convert indexed profiles to its textual output and show it.
RUN: llvm-profdata merge --text -o %t/text-from-indexed.proftext %t/indexed.profdata
RUN: llvm-profdata show --function=main --argument-values %t/text-from-indexed.proftext | FileCheck %s --check-prefix=INDEXED
RUN: llvm-profdata show --function=main --argument-values --text %t/text-from-indexed.proftext | FileCheck %s --check-prefix=ARGTEXT

INDEXED: Counters:
